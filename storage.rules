rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /pdfs/{pdfId} {
      // Anyone can view and download study materials & past questions
      allow read: if true;
      // Authenticated students can upload PDF documents under 50MB
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf');
    }
  }
}
